---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---

<Base
	title="Terms of use — Infinitix"
	description="Infinitix terms of use and license."
	lang="en"
	altHref={`${base}/terms/`}
>
	<Header lang="en" esHref={`${base}/terms/`} enHref={`${base}/en/terms/`} />

	<main class="prose">
		<h1>Infinitix terms of use</h1>
		<p class="updated"><strong>Last updated:</strong> September 1, 2026</p>

		<p>
			By downloading, installing, or playing Infinitix ("the Game"), you agree to these
			Terms of use. If you do not agree, do not use the Game.
		</p>

		<h2>License to use</h2>
		<p>
			You are granted a personal, non-exclusive, non-transferable, and revocable license to
			install and use the Game on your own devices, for personal, non-commercial use only.
			This license does not transfer any ownership of the Game, its code, its assets, or
			its brand to you — all of that remains the property of the developer.
		</p>

		<h2>Free, no in-app purchases</h2>
		<p>
			Infinitix is free. The current version has no in-app purchases, no advertising, and
			no payment system of any kind. All of the Game's internal economy (Coins, Score,
			Libras) is earned only by playing and has no real monetary value and cannot be
			exchanged for money.
		</p>

		<h2>Characters and Game content</h2>
		<p>
			The roster of characters included in the Game may include names and likenesses
			inspired by real people, used with their explicit consent. If you also create your
			own character inside the Game using a photo of yourself or a third party, you are
			the one guaranteeing you have the right to use that image; that photo is saved only
			on your device (see the <a href={`${base}/privacy/`}>Privacy policy</a>).
		</p>

		<h2>No warranties</h2>
		<p>
			The Game is provided "as is," without warranties of any kind, express or implied,
			including but not limited to warranties of merchantability, fitness for a particular
			purpose, or absence of errors. There is no guarantee the Game will run without
			interruption or free of bugs on every device.
		</p>

		<h2>Limitation of liability</h2>
		<p>
			To the maximum extent permitted by applicable law, the developer will not be liable
			for indirect, incidental, or consequential damages arising from the use or inability
			to use the Game.
		</p>

		<h2>Changes</h2>
		<p>
			These Terms may be updated as the Game evolves. The current version will always be
			published at this same address.
		</p>

		<h2>Governing law</h2>
		<p>
			These Terms are governed by the laws of the Argentine Republic, without regard to its
			conflict-of-law provisions. Any dispute related to the Game that cannot be resolved
			informally will be submitted to the competent courts of the Argentine Republic.
		</p>

		<h2>Contact</h2>
		<p>
			For questions about these Terms, write to:
			<a href="mailto:francobusch130@gmail.com">francobusch130@gmail.com</a>.
		</p>
	</main>

	<Footer lang="en" />
</Base>

<style>
	.prose {
		padding-top: 48px;
	}

	.prose h1 {
		color: var(--cyan);
		font-size: 1.8rem;
	}

	.prose h2 {
		color: var(--cyan);
		font-size: 1.15rem;
		margin-top: 2em;
	}

	.prose .updated {
		color: var(--text-dim);
	}
</style>
