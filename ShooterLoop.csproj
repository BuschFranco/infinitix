<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <!-- net9.0, not net8.0: Godot 4.7.1's prebuilt Android export template for C# only supports
         net9.0, and refuses the export outright otherwise ("la plantilla de exportación solo
         soporta 'net9.0'"). The alternative was a Gradle custom build, which needs the Android
         build template plus the .NET android workload — more moving parts for the same result.
         Desktop exports are unaffected; they build from this same target. -->
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>ShooterLoop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- android/build is the Gradle build template Godot installs/generates for Android export.
         Its src/main/assets is a packaged copy of this same project (Scripts, Scenes, etc.) — the
         SDK's default **/*.cs glob was picking those up as source too, so every class ended up
         compiled twice (CS0102/CS0111 duplicate-definition errors across the whole codebase). -->
    <Compile Remove="android/**/*.cs" />
    <None Remove="android/**/*.cs" />
  </ItemGroup>
</Project>
